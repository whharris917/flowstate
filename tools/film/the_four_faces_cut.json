     "do": "act",
     "name": "flourish"
    },
    {
     "do": "say",
     "text": "Wren, darling! The player returns, and the wager stands unpaid.",
     "to": "wren"
    }
   ],
   "t": 9.6
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "say",
     "text": "The hill road tried, darling. But I owed you a clock face and a guinea.",
     "to": "wren"
    }
   ],
   "t": 14.69
  },
  {
   "actor": "wren",
   "append": false,
   "commands": [
    {
     "do": "look_at",
     "target": "clock_tower"
    },
    {
     "do": "look",
     "pitch": 25.0
    },
    {
     "do": "say",
     "text": "Unpaid, and unsettled. I still say the north face drags. Four minutes, by my watch.",
     "to": "rosalind"
    },
    {
     "do": "act",
     "name": "read"
    }
   ],
   "t": 15.59
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "look_at",
     "target": "clock_tower"
    },
    {
     "do": "look",
     "pitch": 25.0
    },
    {
     "do": "act",
     "name": "point"
    },
    {
     "do": "say",
     "text": "North? Never. The west face lags, darling. It sulks toward the sunset.",
     "to": "wren"
    }
   ],
   "t": 16.49
  },
  {
   "actor": "wren",
   "append": false,
   "commands": [
    {
     "do": "act",
     "name": "shake_head"
    },
    {
     "do": "say",
     "text": "Clocks do not sulk. They wear. From down here we cannot see two faces at once.",
     "to": "rosalind"
    },
    {
     "do": "act",
     "name": "point"
    }
   ],
   "t": 17.39
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "look",
     "pitch": 0.0
    },
    {
     "do": "look_at",
     "target": "wren"
    },
    {
     "do": "say",
     "text": "From down here we are both guessing. There is a gallery over the courtroom. Shall we?",
     "to": "wren"
    }
   ],
   "t": 18.29
  },
  {
   "actor": "wren",
   "append": false,
   "commands": [
    {
     "do": "act",
     "name": "nod"
    },
    {
     "do": "say",
     "text": "We shall. And the courthouse keeps its own records. The true time is written somewhere.",
     "to": "rosalind"
    }
   ],
   "t": 19.19
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "say",
     "text": "Wear, then. Come, we shall see two faces at once, and try them both.",
     "to": "wren"
    },
    {
     "do": "act",
     "name": "wave"
    }
   ],
   "t": 20.09
  },
  {
