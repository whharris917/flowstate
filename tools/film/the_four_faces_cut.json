     "name": "wave"
    },
    {
     "do": "say",
     "text": "The court calls the keeper of the winding book! Approach, sir, and be sworn.",
     "to": "clerk"
    }
   ],
   "t": 39.57
  },
  {
   "actor": "wren",
   "append": false,
   "commands": [
