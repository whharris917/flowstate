   "card": "THE FOUR FACES",
   "secs": 4.0
  },
  {
   "t": 4.3,
   "card": "Monroe, North Carolina.  Four o'clock, give or take.",
   "secs": 3.2
  },
  {
   "t": 7.8,
   "camera": {
    "mode": "auto",
    "cut": true
   }
