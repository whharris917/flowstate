     "target": "clerk"
    },
    {
     "do": "act",
     "name": "wave"
    },
    {
     "do": "say",
     "text": "Keeper! Forgive an old woman her hurry. May I see the winding book?",
     "to": "clerk"
    }
   ],
   "t": 40.47
  },
  {
   "actor": "clerk",
   "append": false,
   "commands": [
