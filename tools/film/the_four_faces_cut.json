    {
     "do": "act",
     "name": "nod"
    },
    {
     "do": "say",
     "text": "Good morning. We are bound for the gallery, to settle a clock.",
     "to": "clerk"
    }
   ],
   "t": 25.99
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "look_at",
     "target": "clerk"
    },
    {
     "do": "act",
     "name": "nod"
    },
    {
     "do": "say",
     "text": "Good morning, keeper. Is the gallery open to two quarrelling witnesses?",
     "to": "clerk"
    }
   ],
   "t": 26.89
  },
  {
   "actor": "clerk",
   "append": false,
   "commands": [
    {
     "do": "look_at",
     "target": "wren"
    },
    {
     "do": "act",
     "name": "bow"
    },
    {
     "do": "say",
     "text": "Open to witnesses, always. Up the north stair, ladies. The court is not sitting today.",
     "to": "rosalind"
    },
    {
     "do": "act",
     "name": "read"
    },
    {
     "do": "say",
     "text": "Though if it is the time you want settled... I keep the winding book.",
     "to": "wren"
    }
   ],
   "t": 28.27
  },
  {
   "actor": "wren",
   "append": false,
   "commands": [
    {
     "do": "say",
     "text": "After you, Rosalind. Mind the stairs; my knees are older than this building.",
     "to": "rosalind"
    }
   ],
   "t": 29.17
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "say",
     "text": "Older than the building? Then you outrank it, darling. Up we go.",
     "to": "wren"
    }
   ],
   "t": 30.07
  },
  {
   "t": 34.07,
   "card": "Upstairs, the court was not sitting.  Until it was.",
