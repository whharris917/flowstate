    },
    {
     "do": "act",
     "name": "wave"
    },
    {
     "do": "say",
     "text": "Rosalind. You came back. I half feared the hill road had kept you.",
     "to": "rosalind"
    }
   ],
   "t": 8.7
  },
  {
   "actor": "rosalind",
   "append": false,
   "commands": [
    {
     "do": "go",
     "to": "wren"
